{
  "name": "richardmaximun/laravel-cart-guest-ui",
  "description": "UI para binafy/laravel-cart con invitados, merge on login, badge Livewire/AJAX y vista con spatie media.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "binafy/laravel-cart": "^1.0"
  },
  "suggest": {
    "livewire/livewire": "^3.0",
    "spatie/laravel-medialibrary": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Richardmaximun\\CartGuestUi\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Richardmaximun\\CartGuestUi\\CartGuestUiServiceProvider"
      ]
    }
  }
}
